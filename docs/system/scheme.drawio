<mxfile host="hyp-arena"><diagram name="Шаги"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="1400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ct" value="&lt;b&gt;Схема системы (метод v3.8)&lt;/b&gt; — шаги, кто их делает и чем проверены" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1060" height="30" as="geometry"/></mxCell><mxCell id="cs0" value="&lt;b&gt;Шаг 0. Гипотезы на входе&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;реестры испытаний; генерация по теме; версии лучших&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="470" height="74" as="geometry"/></mxCell><mxCell id="cw0" value="LLM + код" style="rounded=1;html=1;fontSize=11;fillColor=#EEF0FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="92" width="90" height="30" as="geometry"/></mxCell><mxCell id="cv0" value="&lt;b&gt;частично&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;правила версий проверяет код; качество новых гипотез не измерено&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B7791F;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="70" width="480" height="74" as="geometry"/></mxCell><mxCell id="cs1" value="&lt;b&gt;Шаг 1. Карточка гипотезы&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;вмешательство, популяция, исход, шаги механизма, эксперимент&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="166" width="470" height="74" as="geometry"/></mxCell><mxCell id="cw1" value="LLM + код" style="rounded=1;html=1;fontSize=11;fillColor=#EEF0FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="188" width="90" height="30" as="geometry"/></mxCell><mxCell id="cv1" value="&lt;b&gt;частично&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;перефразирование: субъект, отношение, объект 1.00, контекст 0.80; механизм 6 из 8&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B7791F;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="166" width="480" height="74" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=block;html=1;strokeColor=#1E4D40;" edge="1" parent="1" source="cs0" target="cs1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cs2" value="&lt;b&gt;Шаг 2. Поиск статей&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;PubMed до даты среза для каждого шага&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="470" height="74" as="geometry"/></mxCell><mxCell id="cw2" value="LLM + код" style="rounded=1;html=1;fontSize=11;fillColor=#EEF0FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="284" width="90" height="30" as="geometry"/></mxCell><mxCell id="cv2" value="&lt;b&gt;пройдено&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;95% ключевых статей второго читателя найдено&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F1E8;strokeColor=#2E7D4F;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="262" width="480" height="74" as="geometry"/></mxCell><mxCell id="e2" style="endArrow=block;html=1;strokeColor=#1E4D40;" edge="1" parent="1" source="cs1" target="cs2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cs3" value="&lt;b&gt;Шаг 3. Чтение статей&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;находки с дословной цитатой: за / против, дизайн, выборка&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="358" width="470" height="74" as="geometry"/></mxCell><mxCell id="cw3" value="LLM + код" style="rounded=1;html=1;fontSize=11;fillColor=#EEF0FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="380" width="90" height="30" as="geometry"/></mxCell><mxCell id="cv3" value="&lt;b&gt;частично&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;поля 92–96%; находки на своём шаге 19–52% — главная потеря&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B7791F;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="358" width="480" height="74" as="geometry"/></mxCell><mxCell id="e3" style="endArrow=block;html=1;strokeColor=#1E4D40;" edge="1" parent="1" source="cs2" target="cs3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cs4" value="&lt;b&gt;Шаг 4. Вес находки&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;дизайн × точность × эффект × сравнение × контекст (GRADE)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="454" width="470" height="74" as="geometry"/></mxCell><mxCell id="cw4" value="код" style="rounded=1;html=1;fontSize=11;fillColor=#F1F1F1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="476" width="90" height="30" as="geometry"/></mxCell><mxCell id="cv4" value="&lt;b&gt;пройдено&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;поздние испытания того же шага: AUC 0.70&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F1E8;strokeColor=#2E7D4F;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="454" width="480" height="74" as="geometry"/></mxCell><mxCell id="e4" style="endArrow=block;html=1;strokeColor=#1E4D40;" edge="1" parent="1" source="cs3" target="cs4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cs5" value="&lt;b&gt;Шаг 5. Сила шага и баланс&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;«за» и «против» → сила шага → баланс цепочки, покрытие&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="470" height="74" as="geometry"/></mxCell><mxCell id="cw5" value="код" style="rounded=1;html=1;fontSize=11;fillColor=#F1F1F1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="572" width="90" height="30" as="geometry"/></mxCell><mxCell id="cv5" value="&lt;b&gt;частично&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;исходы прошлых испытаний: AUC 0.59&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B7791F;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="550" width="480" height="74" as="geometry"/></mxCell><mxCell id="e5" style="endArrow=block;html=1;strokeColor=#1E4D40;" edge="1" parent="1" source="cs4" target="cs5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cs6" value="&lt;b&gt;Шаг 6. Новизна&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;расстояние до уже изученного до даты среза&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="646" width="470" height="74" as="geometry"/></mxCell><mxCell id="cw6" value="код" style="rounded=1;html=1;fontSize=11;fillColor=#F1F1F1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="668" width="90" height="30" as="geometry"/></mxCell><mxCell id="cv6" value="&lt;b&gt;не пройдено&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;второй читатель: κ 0.14–0.26, завышена&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8E6;strokeColor=#C0392B;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="646" width="480" height="74" as="geometry"/></mxCell><mxCell id="e6" style="endArrow=block;html=1;strokeColor=#1E4D40;" edge="1" parent="1" source="cs5" target="cs6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cs7" value="&lt;b&gt;Шаг 7. Эксперимент и альтернативы&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;какие подкреплённые объяснения отсекает эксперимент&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="742" width="470" height="74" as="geometry"/></mxCell><mxCell id="cw7" value="LLM + код" style="rounded=1;html=1;fontSize=11;fillColor=#EEF0FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="764" width="90" height="30" as="geometry"/></mxCell><mxCell id="cv7" value="&lt;b&gt;частично&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;второй читатель: κ 0.35&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B7791F;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="742" width="480" height="74" as="geometry"/></mxCell><mxCell id="e7" style="endArrow=block;html=1;strokeColor=#1E4D40;" edge="1" parent="1" source="cs6" target="cs7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cs8" value="&lt;b&gt;Шаг 8. Прочие показатели&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;реализуемость, конечная точка, рост внимания, роль ИИ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="838" width="470" height="74" as="geometry"/></mxCell><mxCell id="cw8" value="LLM + код" style="rounded=1;html=1;fontSize=11;fillColor=#EEF0FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="860" width="90" height="30" as="geometry"/></mxCell><mxCell id="cv8" value="&lt;b&gt;частично&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;конечная точка κ 0.93; реализуемость не проверялась&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B7791F;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="838" width="480" height="74" as="geometry"/></mxCell><mxCell id="e8" style="endArrow=block;html=1;strokeColor=#1E4D40;" edge="1" parent="1" source="cs7" target="cs8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cs9" value="&lt;b&gt;Шаг 9. Ранжирование (АСПИД)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;порядок важности → случайные веса → балл и «в топ-5»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="934" width="470" height="74" as="geometry"/></mxCell><mxCell id="cw9" value="код" style="rounded=1;html=1;fontSize=11;fillColor=#F1F1F1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="956" width="90" height="30" as="geometry"/></mxCell><mxCell id="cv9" value="&lt;b&gt;частично&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;правило допуска показателей; профили в пределах 0.03&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B7791F;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="934" width="480" height="74" as="geometry"/></mxCell><mxCell id="e9" style="endArrow=block;html=1;strokeColor=#1E4D40;" edge="1" parent="1" source="cs8" target="cs9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cs10" value="&lt;b&gt;Шаг 10. Улучшения и версии&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;исправимые пункты, их прирост, версии гипотез&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="470" height="74" as="geometry"/></mxCell><mxCell id="cw10" value="код + LLM" style="rounded=1;html=1;fontSize=11;fillColor=#EEF0FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="1052" width="90" height="30" as="geometry"/></mxCell><mxCell id="cv10" value="&lt;b&gt;частично&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;восемь правил версий проверяются тестами&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B7791F;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="1030" width="480" height="74" as="geometry"/></mxCell><mxCell id="e10" style="endArrow=block;html=1;strokeColor=#1E4D40;" edge="1" parent="1" source="cs9" target="cs10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cs11" value="&lt;b&gt;Шаг 11. Сквозная проверка&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;60 идущих испытаний, оценки заморожены хешем&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1126" width="470" height="74" as="geometry"/></mxCell><mxCell id="cw11" value="код" style="rounded=1;html=1;fontSize=11;fillColor=#F1F1F1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="1148" width="90" height="30" as="geometry"/></mxCell><mxCell id="cv11" value="&lt;b&gt;ждёт исходов&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;исходы 2026–2028&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#5A6B7B;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="1126" width="480" height="74" as="geometry"/></mxCell><mxCell id="e11" style="endArrow=block;html=1;strokeColor=#1E4D40;" edge="1" parent="1" source="cs10" target="cs11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cleg" value="Статусы: &lt;span style='background:#E3F1E8;border:1px solid #2E7D4F;padding:2px 6px'&gt;пройдено&lt;/span&gt; &lt;span style='background:#FFF4DC;border:1px solid #B7791F;padding:2px 6px'&gt;частично&lt;/span&gt; &lt;span style='background:#FDE8E6;border:1px solid #C0392B;padding:2px 6px'&gt;не пройдено&lt;/span&gt; &lt;span style='background:#ECEFF3;border:1px solid #5A6B7B;padding:2px 6px'&gt;ждёт исходов&lt;/span&gt; &lt;span style='background:#F1F1F1;border:1px solid #888888;padding:2px 6px'&gt;не проверялось&lt;/span&gt;&lt;br/&gt;Подробно: docs/system/steps.md; числа и критерии — specs/" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1222" width="1060" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Проверки и бейзлайн"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="1400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ct2" value="&lt;b&gt;Бейзлайн ChatGPT (GPT-5.x через API, без веб-поиска)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="cb0" value="&lt;b&gt;Чтение (шаги 1, 3, 7)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="230" height="80" as="geometry"/></mxCell><mxCell id="ch0" value="GPT получает тот же текст, сравнение с тем же эталоном (второй читатель, известные факты)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F2;strokeColor=#CCCCCC;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="470" height="80" as="geometry"/></mxCell><mxCell id="cl0" value="утечка не мешает" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#5A6B7B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="220" height="80" as="geometry"/></mxCell><mxCell id="cb1" value="&lt;b&gt;Вес находки (шаг 4)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="166" width="230" height="80" as="geometry"/></mxCell><mxCell id="ch1" value="GPT упорядочивает те же пары находок" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F2;strokeColor=#CCCCCC;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="166" width="470" height="80" as="geometry"/></mxCell><mxCell id="cl1" value="утечка не мешает" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#5A6B7B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="166" width="220" height="80" as="geometry"/></mxCell><mxCell id="cb2" value="&lt;b&gt;Прогноз исхода (шаг 11)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="230" height="80" as="geometry"/></mxCell><mxCell id="ch2" value="ответы GPT по 60 проспективным испытаниям закрепляются хешем рядом с нашими" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F2;strokeColor=#CCCCCC;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="262" width="470" height="80" as="geometry"/></mxCell><mxCell id="cl2" value="утечки нет: исходов ещё нет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#5A6B7B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="262" width="220" height="80" as="geometry"/></mxCell><mxCell id="cb3" value="&lt;b&gt;Прошлые испытания&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E4D40;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="358" width="230" height="80" as="geometry"/></mxCell><mxCell id="ch3" value="модели, спрошенные напрямую: AUC 0.76 против 0.59 у баланса" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F2;strokeColor=#CCCCCC;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="358" width="470" height="80" as="geometry"/></mxCell><mxCell id="cl3" value="утечка не исключена" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF3;strokeColor=#5A6B7B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="358" width="220" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>